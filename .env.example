# Supabase - from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-side only (check-in actions, notification job).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL, used to build the QR check-in / join links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend - transactional email for expiry and inactivity notifications
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=gym@yourdomain.com
OWNER_EMAIL=owner@yourdomain.com

# Shared secret guarding the daily cron route (/api/notifications).
# Vercel Cron sends this as an Authorization: Bearer header when set.
CRON_SECRET=